# Copie este arquivo para ".env" e preencha os valores.

# URL do CSV publicado do Google Sheets.
# Como obter: no Google Sheets -> Arquivo -> Compartilhar -> Publicar na web
# -> escolha a aba -> formato "Valores separados por vírgula (.csv)" -> Publicar.
# Cole aqui o link gerado (termina com output=csv).
SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/SEU_ID_AQUI/pub?gid=0&single=true&output=csv

# Número da lojista com DDI + DDD, só dígitos (ex: 55 = Brasil, 11 = DDD SP).
WHATSAPP_LOJISTA=5511999999999

# Nome da loja (aparece no título e no cabeçalho).
NOME_LOJA=Ateliê da Ana

# Chave PIX (opcional, apenas informativa na mensagem).
CHAVE_PIX=ana@email.com

# Segundos de cache da planilha (evita bater no Google a cada request).
CACHE_TTL=60
